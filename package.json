{
  "name": "steady",
  "version": "0.1.0",
  "private": true,
  "description": "Steady: hands-free painting for Krita with a resting hand, tremor-aware smoothing and voice.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "helper": "bash scripts/run-helper.sh",
    "fake-helper": "bash scripts/run-fake-helper.sh",
    "demo-chrome": "bash scripts/demo-chrome.sh",
    "krita-plugin:install": "bash scripts/krita-plugin-install.sh",
    "pytest": "bash scripts/run-pytest.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@cartesia/cartesia-js": "4.2.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "1eurofilter": "1.3.0",
    "lazy-brush": "2.0.2",
    "next": "16.4.3",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simplify-js": "1.2.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
